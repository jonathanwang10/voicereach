# Supabase Configuration
SUPABASE_URL=https://[project-id].supabase.co
SUPABASE_ANON_KEY=[your-anon-key]
SUPABASE_SERVICE_KEY=[your-service-role-key]

# OpenAI Configuration
OPENAI_API_KEY=[your-openai-api-key]

# Optional: comma-separated account emails allowed to use the API
# (case-insensitive). Anyone else who signs in gets a 403. Unset = any user of
# the Supabase project is accepted.
# ALLOWED_USER_EMAILS=demo@sfgov.org

# Optional: comma-separated browser origins allowed by CORS (unset = none).
# The mobile app is not a browser and does not need this.
# CORS_ALLOW_ORIGINS=https://dashboard.example.org

# Optional: per-user requests per minute on the endpoints that cost OpenAI money
# (positive integers; unset or invalid = the default shown).
# RATE_LIMIT_TRANSCRIBE_PER_MIN=30
# RATE_LIMIT_ASSISTANT_TRANSCRIBE_PER_MIN=30
# RATE_LIMIT_EMBEDDINGS_SEARCH_PER_MIN=60
# RATE_LIMIT_EMBEDDINGS_GENERATE_PER_MIN=30
# RATE_LIMIT_GENERATE_ALL_PER_MIN=1
# RATE_LIMIT_DUPLICATE_CHECK_PER_MIN=30
# RATE_LIMIT_WS_CONNECT_PER_MIN=10

# Optional: seconds one realtime voice-assistant connection may stay open.
# REALTIME_MAX_SESSION_SECONDS=600
