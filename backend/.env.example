# Supabase Configuration
SUPABASE_URL=https://[project-id].supabase.co
# Settings -> API Keys (H2-8.3): the new keys first
SUPABASE_PUBLISHABLE_KEY=[sb_publishable_...]
SUPABASE_SECRET_KEY=[sb_secret_...]
# Fallback until legacy keys are disabled:
# SUPABASE_ANON_KEY=[your-anon-key]
# SUPABASE_SERVICE_KEY=[your-service-role-key]

# OpenAI Configuration
OPENAI_API_KEY=[your-openai-api-key]

# Optional: comma-separated account emails allowed to use the API
# (case-insensitive). Anyone else who signs in gets a 403. Unset = any user of
# the Supabase project is accepted.
# ALLOWED_USER_EMAILS=demo@sfgov.org

# Optional: comma-separated browser origins allowed by CORS (unset = none).
# The mobile app is not a browser and does not need this.
# CORS_ALLOW_ORIGINS=https://dashboard.example.org

# Optional: requests per minute on the paid or heavy endpoints, per user + X-Device-Id
# (positive integers; unset or invalid = the default shown). Each bucket also has a
# per-process total, RATE_LIMIT_<NAME>_TOTAL_PER_MIN, default 5x the per-device limit.
# RATE_LIMIT_TRANSCRIBE_PER_MIN=30
# RATE_LIMIT_EMBEDDINGS_SEARCH_PER_MIN=60
# RATE_LIMIT_EMBEDDINGS_GENERATE_PER_MIN=30
# RATE_LIMIT_GENERATE_ALL_PER_MIN=1
# RATE_LIMIT_DUPLICATE_CHECK_PER_MIN=30
# RATE_LIMIT_WS_CONNECT_PER_MIN=10
# RATE_LIMIT_SAVE_PER_MIN=30
# RATE_LIMIT_CATEGORY_CREATE_PER_MIN=10
# RATE_LIMIT_DELETE_PER_MIN=30
# RATE_LIMIT_SAVE_TOTAL_PER_MIN=150

# Optional: serve the interactive API docs (/docs, /redoc, /openapi.json).
# Only the exact value 1 turns them on; unset = off.
# ENABLE_API_DOCS=1

# Optional: OpenAI model names (blank or unset = the default shown).
# CHAT_MODEL=gpt-4o
# TRANSCRIBE_MODEL=gpt-transcribe
# REALTIME_MODEL=gpt-realtime-2.1
# EMBEDDING_MODEL=text-embedding-3-large
# DUPLICATE_MODEL=gpt-4o-mini

# Load testing only (H2-8.5): fake OpenAI calls; refused unless ENVIRONMENT=loadtest
# VOICEREACH_FAKE_OPENAI=1

# Optional: plain-text logs instead of JSON lines (H2-8.1)
# LOG_FORMAT=text

# Optional: concurrent realtime sessions per phone (user + X-Device-Id) and per process.
# REALTIME_MAX_SESSIONS_PER_USER=2
# REALTIME_MAX_SESSIONS_TOTAL=20

# Optional: seconds one realtime voice-assistant connection may stay open.
# REALTIME_MAX_SESSION_SECONDS=600

# Optional: recordings worker (H2-7.3). How many jobs run at once in this process.
RECORDING_WORKER_CONCURRENCY=2
# Optional: 0 pauses processing uploaded recordings (they stay queued).
RECORDING_WORKER_ENABLED=1

# Optional: Sentry error reports (scrubbed, errors only); unset means off (H2-8.2)
# SENTRY_DSN=
# Optional: Sentry's environment name (default development)
# ENVIRONMENT=production
